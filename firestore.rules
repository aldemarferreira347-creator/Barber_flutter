rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwnerRole() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isOwnerOfShop(shopId) {
      return isSignedIn() && shopId != null &&
        exists(/databases/$(database)/documents/barbershops/$(shopId)) &&
        get(/databases/$(database)/documents/barbershops/$(shopId)).data.ownerId == request.auth.uid;
    }

    function isBarberOfShop(shopId) {
      return isSignedIn() && shopId != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'barber' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barbershopId == shopId;
    }

    function isStaffOfShop(shopId) {
      return isOwnerOfShop(shopId) || isBarberOfShop(shopId);
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // Mismo formato que appointmentSlotId() (Dart) y slotId() (TS):
    // "{barberId}_yyyy-MM-ddTHH:mm" en UTC. Permite que la regla compruebe
    // que un slot corresponde EXACTAMENTE al minuto de su cita.
    function slotIdFor(barberId, ts) {
      return barberId + '_' + string(ts.year()) + '-' + pad2(ts.month()) + '-' + pad2(ts.day()) +
        'T' + pad2(ts.hours()) + ':' + pad2(ts.minutes());
    }

    // Validación de un ítem de purchases/{id}.items[i] (spec 10.1) contra
    // el catálogo real de esa barbería — el precio y el nombre NUNCA se
    // confían del cliente, igual que el precio de un servicio en
    // appointments. Ver el comentario en purchases/{id} sobre por qué esto
    // solo se acota a un número fijo de ítems (createPurchase.itemValid).
    function purchaseItemValid(barbershopId, item) {
      let product = get(/databases/$(database)/documents/barbershops/$(barbershopId)/products/$(item.productId)).data;
      return item.quantity is int && item.quantity > 0 &&
        product.active == true &&
        item.unitPrice == product.price &&
        item.productName == product.name &&
        item.refunded == false;
    }

    // Suma de unitPrice*quantity de hasta CloudPurchaseService.maxItems (5)
    // ítems — sin loops/reduce en el lenguaje de reglas, se desenrolla a
    // mano para ese tope fijo.
    function purchaseItemsTotal(items) {
      return items.size() == 1
        ? items[0].unitPrice * items[0].quantity
        : items.size() == 2
        ? items[0].unitPrice * items[0].quantity + items[1].unitPrice * items[1].quantity
        : items.size() == 3
        ? items[0].unitPrice * items[0].quantity + items[1].unitPrice * items[1].quantity +
          items[2].unitPrice * items[2].quantity
        : items.size() == 4
        ? items[0].unitPrice * items[0].quantity + items[1].unitPrice * items[1].quantity +
          items[2].unitPrice * items[2].quantity + items[3].unitPrice * items[3].quantity
        : items[0].unitPrice * items[0].quantity + items[1].unitPrice * items[1].quantity +
          items[2].unitPrice * items[2].quantity + items[3].unitPrice * items[3].quantity +
          items[4].unitPrice * items[4].quantity;
    }

    // Un reembolso parcial (spec 10.5) solo puede voltear 'refunded' de
    // false a true en cada ítem — precio, cantidad y nombre quedan fijos
    // desde que se creó la compra.
    function purchaseItemRefundOnlyChanged(before, after) {
      return before.productId == after.productId &&
        before.productName == after.productName &&
        before.unitPrice == after.unitPrice &&
        before.quantity == after.quantity &&
        (before.refunded == after.refunded || (before.refunded == false && after.refunded == true));
    }

    // users/{uid}: el autorregistro público solo puede crear rol 'client'
    // (Dueño se obtiene pagando, Barbero lo crea su Dueño, Admin no se
    // autorregistra — todo eso lo asigna el admin cambiando el rol después).
    // Un usuario puede editar su propio perfil pero NUNCA su propio rol ni
    // su propio estado 'active' (evita autopromoción y autodesbloqueo).
    match /users/{uid} {
      // Nota técnica: para que las CONSULTAS (no solo los get por id)
      // funcionen, Firestore exige poder demostrar la regla a partir del
      // propio filtro de la consulta — por eso estas condiciones dependen
      // solo de resource.data.role (que si va en el where de la consulta)
      // y no de funciones con get()/exists() como isOwnerOfShop().
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        // Perfiles de Cliente (email, teléfono): solo los necesita un Dueño
        // para buscarlos por correo y contratarlos como Barbero — el resto
        // de usuarios no ve datos de contacto ajenos. isOwnerRole() solo
        // depende del documento de quien consulta, así que la consulta
        // sigue siendo demostrable con el filtro role == 'client'.
        (resource.data.role == 'client' && isOwnerRole()) ||
        // Perfiles de Barbero: los necesita el Cliente para elegir con
        // quién agendar su cita.
        resource.data.role == 'barber'
      );

      // Un perfil nuevo no puede traer precargados los campos que solo
      // mueven las ramas dedicadas de abajo (calificación, ausencia) ni una
      // barbería: de lo contrario, al ser contratado como Barbero llegaría
      // con un promedio inflado o ya atado a otra barbería.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'client'
        && request.resource.data.active == true
        && !request.resource.data.keys().hasAny(['ratingSum', 'ratingCount', 'awaySince', 'awayUntilEstimate'])
        && request.resource.data.get('barbershopId', null) == null;

      allow update: if isSignedIn() && (
        (
          // awayUntilEstimate/awaySince (spec 3.3) y ratingSum/ratingCount
          // (spec 7.1) del propio barbero no se tocan en NINGUNA de estas
          // ramas — solo pueden cambiar por las ramas dedicadas de abajo.
          // .get(campo, default) en vez de acceso directo: ningún users/{uid}
          // trae estos 4 campos al crearse (AppUser.toMap() no los incluye),
          // así que la mayoría de los documentos simplemente no los tienen —
          // acceder a una clave ausente con resource.data.X hace fallar TODA
          // la regla, no solo esta comparación (bug real que bloqueaba
          // cualquier edición de admin sobre esos usuarios).
          request.resource.data.get('awayUntilEstimate', null) == resource.data.get('awayUntilEstimate', null) &&
          request.resource.data.get('awaySince', null) == resource.data.get('awaySince', null) &&
          request.resource.data.get('ratingSum', 0) == resource.data.get('ratingSum', 0) &&
          request.resource.data.get('ratingCount', 0) == resource.data.get('ratingCount', 0) &&
          (
            // barbershopId NO lo cambia el propio usuario: define de qué
            // barbería es personal (isBarberOfShop), así que solo lo mueven
            // el admin o el dueño de esa barbería en las ramas de abajo.
            (request.auth.uid == uid &&
              request.resource.data.role == resource.data.role &&
              request.resource.data.active == resource.data.active &&
              request.resource.data.get('barbershopId', null) == resource.data.get('barbershopId', null)) ||
            isAdmin() ||
            // Auto-promoción Cliente -> Dueño al registrar su primera
            // barbería (spec 12.1). Antes pasaba por requestBarbershopOwnership
            // (Admin SDK), pero esa vía requiere el plan Blaze; esto la
            // reemplaza sin abrir hueco de seguridad porque el rol 'owner'
            // por sí solo no da NINGÚN permiso adicional — cada acción de
            // dueño (servicios, productos, horario, etc.) revalida por su
            // cuenta isOwnerOfShop(), que exige un barbershops/{id}.ownerId
            // == uid real, sin importar el rol declarado en users/{uid}.
            (request.auth.uid == uid &&
              resource.data.role == 'client' &&
              request.resource.data.role == 'owner' &&
              request.resource.data.active == resource.data.active &&
              request.resource.data.get('barbershopId', null) == resource.data.get('barbershopId', null)) ||
            // Dueño contrata a un Cliente existente como Barbero de su negocio.
            (resource.data.role == 'client' &&
              request.resource.data.role == 'barber' &&
              isOwnerOfShop(request.resource.data.barbershopId) &&
              request.resource.data.active == resource.data.active &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'barbershopId'])) ||
            // Dueño da de baja a un Barbero de su propio negocio (vuelve a Cliente).
            (resource.data.role == 'barber' &&
              request.resource.data.role == 'client' &&
              request.resource.data.barbershopId == null &&
              isOwnerOfShop(resource.data.barbershopId) &&
              request.resource.data.active == resource.data.active &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'barbershopId']))
          )
        ) ||
        // markBarberAway (spec 3.3): el propio barbero declara su salida y
        // un estimado propio de 5 a 240 minutos — antes lo hacía
        // markBarberAway (Admin SDK). El límite de aplazamiento automático
        // de sus reservas sale siempre de este estimado, nunca de un valor
        // fijo (por eso se acota aquí, no solo en el cliente).
        (request.auth.uid == uid &&
          resource.data.role == 'barber' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['awaySince', 'awayUntilEstimate']) &&
          request.resource.data.awaySince == request.time &&
          request.resource.data.awayUntilEstimate is timestamp &&
          request.resource.data.awayUntilEstimate.toMillis() >= request.time.toMillis() + 5 * 60 * 1000 &&
          request.resource.data.awayUntilEstimate.toMillis() <= request.time.toMillis() + 240 * 60 * 1000) ||
        // markBarberReturned (spec 3.3): antes markBarberReturned (Admin SDK).
        (request.auth.uid == uid &&
          resource.data.role == 'barber' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['awaySince', 'awayUntilEstimate']) &&
          request.resource.data.awaySince == null &&
          request.resource.data.awayUntilEstimate == null) ||
        // ratingSum/ratingCount (spec 7.1) del propio barbero: antes los
        // sumaba submitAppointmentRating (Admin SDK) en la MISMA transacción
        // que crea ratings/{appointmentId}; sin Cloud Functions no se puede
        // atar criptográficamente esta suma a esa calificación exacta (una
        // regla no ve las escrituras pendientes de otro documento en su
        // misma transacción). Se acota el daño posible en vez de impedirlo
        // del todo: el conteo solo sube de 1 en 1, y la suma solo sube por
        // un entero entre 1 y 5 (el rango real de cualquier calificación
        // honesta) — igual que el resto de compensaciones sin Blaze, no hay
        // dinero de por medio, solo un promedio visible.
        (resource.data.role == 'barber' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount']) &&
          request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1 &&
          request.resource.data.ratingSum >= resource.data.get('ratingSum', 0) + 1 &&
          request.resource.data.ratingSum <= resource.data.get('ratingSum', 0) + 5)
      );

      // El admin elimina el perfil de Firestore (la cuenta de Firebase Auth
      // queda huérfana — se limpia manualmente o con una Cloud Function el
      // día que haya plan Blaze, ver el comentario en UserRepository.deleteUser).
      // Esto siempre debió ser isAdmin(), no false: bloqueaba por completo el
      // botón "eliminar" de Gestión de usuarios para cualquier admin.
      allow delete: if isAdmin();
    }

    // barbershopDrafts/{uid}_{n}: borradores de barbería SIN pagar. El id
    // solo puede ser `{uid}_1` … `{uid}_5`, así que el tope de 5 borradores
    // por dueño lo impone esta regla (no el cliente) y no se puede saturar
    // la base con datos falsos. Solo su dueño los ve/edita/borra (el admin
    // también los lee); las claves permitidas son cerradas.
    match /barbershopDrafts/{draftId} {
      function isDraftSlotOfCaller() {
        return draftId.matches(request.auth.uid + '_[1-5]');
      }

      function hasDraftShape() {
        return request.resource.data.keys().hasOnly([
          'name', 'ownerId', 'address', 'location', 'phone', 'email',
          'description', 'photoUrl', 'schedule', 'createdAt'
        ]) &&
        request.resource.data.ownerId == request.auth.uid;
      }

      allow read: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && isDraftSlotOfCaller() && hasDraftShape();

      allow update: if isSignedIn() && isDraftSlotOfCaller() &&
        resource.data.ownerId == request.auth.uid && hasDraftShape();

      allow delete: if isSignedIn() && isDraftSlotOfCaller() &&
        resource.data.ownerId == request.auth.uid;
    }

    // barbershops/{id}: cualquier usuario autenticado puede leer (para que
    // el cliente navegue barberías; el catálogo visible se filtra en el
    // cliente por approvalStatus=='approved' && active==true). El dueño
    // crea/edita los datos básicos de la suya, pero NO puede cambiar
    // 'active', 'approvalStatus' ni 'paymentStatus' — esos campos son
    // aprobación/bloqueo exclusivo del admin (spec 12.1/12.4/12.6).
    //
    // Hallazgo de seguridad corregido aquí: antes el create() exigía
    // active==true && paymentStatus=='ok', es decir cualquier usuario
    // autenticado podía crear su propia barbería ya activa y visible en el
    // catálogo, sin revisión del admin. Ahora toda barbería nace
    // obligatoriamente 'pending' e inactiva.
    match /barbershops/{shopId} {
      allow read: if isSignedIn();

      // Registrar una barbería exige PAGAR primero: el payments/{paymentId}
      // referenciado debe ser del propio dueño, de categoría 'subscription',
      // estar aprobado y apuntar a ESTE id (un mismo pago no sirve para dos
      // barberías). Sin pago se guarda como borrador en barbershopDrafts.
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.active == false
        && request.resource.data.paymentId is string
        && exists(/databases/$(database)/documents/payments/$(request.resource.data.paymentId))
        && get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.payerId == request.auth.uid
        && get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.category == 'subscription'
        && get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.status == 'approved'
        && get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.relatedId == shopId;

      allow update: if isSignedIn() && (
        (resource.data.ownerId == request.auth.uid &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.active == resource.data.active &&
          request.resource.data.approvalStatus == resource.data.approvalStatus &&
          request.resource.data.paymentStatus == resource.data.paymentStatus &&
          // ratingSum/ratingCount (spec 7.1) solo los toca
          // submitAppointmentRating (Admin SDK) — el dueño no puede
          // inflar su propio promedio editando el documento. .get() porque
          // Barbershop.toMap() no incluye estos campos: una barbería recién
          // creada (o sin calificar todavía) no los tiene, y acceder a una
          // clave ausente con resource.data.X tumba la regla entera.
          request.resource.data.get('ratingSum', 0) == resource.data.get('ratingSum', 0) &&
          request.resource.data.get('ratingCount', 0) == resource.data.get('ratingCount', 0)) ||
        isAdmin() ||
        // El dueño paga/renueva la mensualidad de SU barbería (spec 12.5).
        // Antes pasaba por payBarbershopSubscription (Admin SDK) — sin
        // plan Blaze, la app simula el pago y escribe esto directo; la
        // regla exige la transición exacta ("queda al día y activa") y
        // que NINGÚN otro campo se toque en la misma escritura.
        (resource.data.ownerId == request.auth.uid &&
          resource.data.approvalStatus == 'approved' &&
          request.resource.data.active == true &&
          request.resource.data.paymentStatus == 'ok' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['active', 'paymentStatus', 'paymentDueDate'])) ||
        // El dueño cancela la membresía directamente: bloquea de inmediato,
        // sin período de gracia (spec 12.5) — antes cancelBarbershopSubscription.
        (resource.data.ownerId == request.auth.uid &&
          request.resource.data.active == false &&
          request.resource.data.paymentStatus == 'blocked' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['active', 'paymentStatus'])) ||
        // ratingSum/ratingCount (spec 7.1) de la barbería: ver el comentario
        // equivalente en users/{uid} sobre por qué solo se puede acotar el
        // incremento a un rango válido, no atarlo criptográficamente a la
        // calificación exacta que lo originó.
        (isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount']) &&
          request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1 &&
          request.resource.data.ratingSum >= resource.data.get('ratingSum', 0) + 1 &&
          request.resource.data.ratingSum <= resource.data.get('ratingSum', 0) + 5)
      );

      // El dueño borra su barbería solo si aún no está aprobada, o si ya
      // canceló la membresía (bloqueada): una barbería viva con citas y pagos
      // no desaparece de un toque. El admin puede siempre.
      allow delete: if isAdmin() || (isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        (resource.data.approvalStatus != 'approved' ||
          resource.data.paymentStatus == 'blocked'));

      // servicios de la barbería: el dueño de ESA barbería (o el admin) los
      // administra; cualquier usuario autenticado puede verlos (catálogo).
      // El precio (y la duración) se validan aquí porque de ellos salen los
      // montos que las reglas de appointments y purchases comparan.
      match /services/{serviceId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && (isOwnerOfShop(shopId) || isAdmin())
          && request.resource.data.price is number && request.resource.data.price >= 0
          && request.resource.data.durationMinutes is int && request.resource.data.durationMinutes > 0;
        allow delete: if isSignedIn() && (isOwnerOfShop(shopId) || isAdmin());
      }

      // productos del catálogo: mismo criterio que servicios.
      match /products/{productId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && (isOwnerOfShop(shopId) || isAdmin())
          && request.resource.data.price is number && request.resource.data.price >= 0;
        allow delete: if isSignedIn() && (isOwnerOfShop(shopId) || isAdmin());
      }

      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // appointments/{id}: el cliente crea su propia cita SIN pago (status
    // 'pending', paid false) directo. Las citas PAGADAS (spec 6.1/6.2)
    // antes solo las creaba bookPaidAppointment (Admin SDK, con bloqueo
    // transaccional del horario) — sin plan Blaze, la app corre la misma
    // transacción directo (ver appointmentSlots) y esta regla exige que el
    // precio no se falsifique y que haya un pago real (simulado) de ese
    // mismo cliente detrás.
    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.barberId == request.auth.uid ||
        isOwnerOfShop(resource.data.barbershopId) ||
        isAdmin()
      );

      allow create: if isSignedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pending'
        && (
          request.resource.data.paid == false ||
          (request.resource.data.paid == true &&
            request.resource.data.rescheduleHistory == [] &&
            request.resource.data.forcedRatingPenalty == false &&
            get(/databases/$(database)/documents/barbershops/$(request.resource.data.barbershopId)/services/$(request.resource.data.serviceId)).data.active == true &&
            request.resource.data.servicePrice ==
              get(/databases/$(database)/documents/barbershops/$(request.resource.data.barbershopId)/services/$(request.resource.data.serviceId)).data.price &&
            request.resource.data.paymentId is string &&
            get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.payerId == request.auth.uid &&
            // El pago debe ser de ESTA cita (relatedId == su id), de
            // categoría 'appointment' y seguir pendiente: así un mismo pago
            // no sirve para reservar varias citas ni uno de otra categoría
            // (p. ej. una suscripción) para reservar sin pagar.
            get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.category == 'appointment' &&
            get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.relatedId == appointmentId &&
            get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.status == 'pending')
        );

      allow update: if isSignedIn() && (
        (
          request.resource.data.paid == resource.data.paid &&
          // Identidad y precio de la cita no cambian en NINGUNA actualización
          // normal (cliente, barbero, dueño o admin): quién reservó, dónde,
          // qué servicio y a qué precio quedan fijos desde la creación.
          request.resource.data.clientId == resource.data.clientId &&
          request.resource.data.barbershopId == resource.data.barbershopId &&
          request.resource.data.get('serviceId', null) == resource.data.get('serviceId', null) &&
          request.resource.data.get('servicePrice', null) == resource.data.get('servicePrice', null) &&
          // .get(campo, default): Appointment.toMap() nunca escribe
          // paymentId ni forcedRatingPenalty en una cita SIN pago (solo se
          // agregan en el flujo de reserva pagada) — acceder a esas claves
          // ausentes con resource.data.X tumbaba la regla entera, es decir
          // bloqueaba aceptar/rechazar/completar CUALQUIER cita sin pago.
          request.resource.data.get('paymentId', null) == resource.data.get('paymentId', null) &&
          // forcedRatingPenalty (spec 3.4) en estas ramas nunca cambia — solo
          // la rama dedicada de closeShopForExternalEvent, más abajo, puede
          // tocarlo.
          request.resource.data.get('forcedRatingPenalty', false) == resource.data.get('forcedRatingPenalty', false) &&
          (
            resource.data.barberId == request.auth.uid ||
            isOwnerOfShop(resource.data.barbershopId) ||
            isAdmin() ||
            // El cliente solo puede cancelar directamente una cita SIN pago
            // (pending → cancelled); una cita pagada pasa por
            // requestAppointmentRefund (spec 6.3).
            (resource.data.clientId == request.auth.uid &&
              resource.data.paid == false &&
              resource.data.status == 'pending' &&
              request.resource.data.status == 'cancelled') ||
            // El cliente pospone su propia cita PAGADA (spec 6.4) — el
            // barbero y el dueño ya podían por la rama de arriba, sin
            // restricción de campos. Antes pasaba por postponeAppointment
            // (Admin SDK) con la misma transacción atómica que ahora corre
            // en el cliente (ver appointmentSlots).
            (resource.data.clientId == request.auth.uid &&
              resource.data.paid == true &&
              !(resource.data.status in ['cancelled', 'completed']) &&
              request.resource.data.status == 'postponed')
          )
        ) ||
        // closeShopForExternalEvent (spec 3.4): el dueño de ESA barbería
        // aplaza cada reserva PAGADA dentro del rango cerrado y marca el
        // descuento obligatorio de calificación — antes lo hacía
        // closeShopForExternalEvent (Admin SDK) en un solo paso por cita;
        // el resto de campos (cliente, barbero, precio, pago...) no se toca.
        (isOwnerOfShop(resource.data.barbershopId) &&
          resource.data.paid == true &&
          resource.data.status in ['pending', 'accepted', 'postponed'] &&
          request.resource.data.status == 'postponed' &&
          request.resource.data.forcedRatingPenalty == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'forcedRatingPenalty']))
      );

      allow delete: if false;
    }

    // appointmentSlots/{id}: bloqueo de horario de una cita pagada (spec
    // 6.2/6.4). Antes lo creaba/borraba solo el backend (Admin SDK, dentro
    // de una transacción); sin plan Blaze, el cliente hace la misma
    // transacción (create() atómico: si el horario ya está tomado, falla
    // entero y no se crea ni la cita ni el pago). Nadie necesita leerlo.
    //
    // Un slot solo puede existir atado a una cita PAGADA real del que lo
    // escribe (o de su barbero/dueño/admin), con el id exacto de su minuto
    // (slotIdFor): getAfter() ve la cita que se escribe en la MISMA
    // transacción. Sin esto cualquiera podía bloquear la agenda entera de un
    // barbero creando slots sueltos, o liberar el horario de una cita ajena
    // para reservarlo encima.
    match /appointmentSlots/{id} {
      allow read: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['appointmentId', 'barberId', 'createdAt'])
        && request.resource.data.barberId is string
        && request.resource.data.appointmentId is string
        && existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.paid == true
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.barberId == request.resource.data.barberId
        && id == slotIdFor(
             request.resource.data.barberId,
             getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.date)
        && (
          getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.clientId == request.auth.uid ||
          request.auth.uid == request.resource.data.barberId ||
          isOwnerOfShop(getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.barbershopId) ||
          isAdmin()
        );

      allow update: if false;

      allow delete: if isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)) && (
          get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.barberId == request.auth.uid ||
          isOwnerOfShop(get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.barbershopId)
        ))
      );
    }

    // shopClosures/{id}: registro de auditoría de cierres por evento
    // externo (spec 3.4). Antes solo lo creaba closeShopForExternalEvent
    // (Admin SDK); sin plan Blaze, el dueño de ESA barbería lo crea directo
    // y luego solo puede corregir appointmentsAffected (el conteo real se
    // sabe después de recorrer las citas afectadas, ver
    // cloud_shop_closure_service.dart). El dueño de esa barbería (o el
    // admin) puede consultarlo.
    match /shopClosures/{id} {
      allow read: if isSignedIn() && (isOwnerOfShop(resource.data.barbershopId) || isAdmin());

      allow create: if isSignedIn()
        && isOwnerOfShop(request.resource.data.barbershopId)
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.appointmentsAffected == 0
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0
        && request.resource.data.closedFrom is timestamp
        && request.resource.data.closedUntil is timestamp
        && request.resource.data.closedUntil > request.resource.data.closedFrom;

      allow update: if isSignedIn()
        && isOwnerOfShop(resource.data.barbershopId)
        && resource.data.requestedBy == request.auth.uid
        && request.resource.data.appointmentsAffected is int
        && request.resource.data.appointmentsAffected >= 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appointmentsAffected']);

      allow delete: if false;
    }

    // refundRequests/{id}: antes la única vía de escritura era el backend
    // (requestAppointmentRefund/resolveAppointmentRefund, Admin SDK); sin
    // plan Blaze, el cliente crea su propia solicitud (spec 6.3) y el
    // dueño de esa barbería (o el admin) la resuelve (spec 6.5), cada uno
    // acotado a exactamente esa transición. El cliente lee las suyas; el
    // dueño de esa barbería (o el admin) lee las de su barbería.
    match /refundRequests/{id} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        isOwnerOfShop(resource.data.barbershopId) ||
        isAdmin()
      );

      allow create: if isSignedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedBy == null
        && request.resource.data.barbershopId == get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.barbershopId
        && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.paid == true
        && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.status != 'cancelled';

      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && (isOwnerOfShop(resource.data.barbershopId) || isAdmin())
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy']);

      allow delete: if false;
    }

    // payments/{id}: la pasarela sigue simulada (no hay Nequi real ni
    // plan Blaze para correr requestPayment/refundPayment en el backend),
    // así que la propia app crea el registro "pendiente" y lo marca
    // "aprobado" tras un breve delay, igual que hacía SimulatedNequiGateway
    // del lado del servidor. El pagador nunca puede fabricar un pago ya
    // aprobado de una, ni tocar su monto una vez creado.
    match /payments/{id} {
      allow read: if isSignedIn() && (resource.data.payerId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.payerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.resolvedAt == null
        && request.resource.data.refundedAmount == null;

      allow update: if isSignedIn() && (
        // El pagador resuelve su propio pago simulado: aprobado tras el
        // delay, o rechazado si algo falló después de crearlo (p.ej. el
        // horario se lo ganó otro cliente) y hay que dejar constancia sin
        // dejarlo "pendiente" para siempre.
        (resource.data.payerId == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['approved', 'rejected'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])) ||
        // Reembolso al aprobar una solicitud de cancelación de cita (spec
        // 6.5): lo dispara el dueño de esa barbería (o el admin), no
        // necesariamente el propio pagador. Acotado a categoría
        // 'appointment'.
        (resource.data.category == 'appointment' &&
          resource.data.status == 'approved' &&
          request.resource.data.status == 'refunded' &&
          request.resource.data.refundedAmount is number &&
          request.resource.data.refundedAmount > 0 &&
          request.resource.data.refundedAmount <= resource.data.amount &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'refundedAmount', 'resolvedAt']) &&
          (isAdmin() || isOwnerOfShop(get(/databases/$(database)/documents/appointments/$(resource.data.relatedId)).data.barbershopId))) ||
        // refundPurchaseItems (spec 6.5/10.5): reservado al admin, igual
        // que en el backend original (un comentario propio ahí dice que el
        // flujo con aprobación del dueño llega en una fase posterior — no
        // se adelanta aquí). Acotado a categoría 'product'.
        (resource.data.category == 'product' &&
          resource.data.status == 'approved' &&
          request.resource.data.status == 'refunded' &&
          request.resource.data.refundedAmount is number &&
          request.resource.data.refundedAmount > 0 &&
          request.resource.data.refundedAmount <= resource.data.amount &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'refundedAmount', 'resolvedAt']) &&
          isAdmin())
      );

      allow delete: if false;
    }

    // purchases/{id}: antes la ÚNICA vía de escritura era el backend
    // (createPurchase/claimPurchase/refundPurchaseItems, Admin SDK); sin
    // plan Blaze, el propio comprador la crea directo (spec 10.1-10.3) con
    // los precios recalculados y validados contra el catálogo real (ver
    // purchaseItemValid arriba) — nunca se confía en lo que mande el
    // cliente. El comprador lee las suyas; el personal de la barbería
    // (dueño o barbero de ESA barbería) lee las de su barbería para
    // atender reclamos; el admin lee todas.
    match /purchases/{id} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        isStaffOfShop(resource.data.barbershopId) ||
        isAdmin()
      );

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
             'barbershopId', 'buyerId', 'appointmentId', 'items', 'totalAmount',
             'paymentId', 'claimCode', 'status', 'createdAt', 'claimedAt', 'expiresAt'
           ])
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.paymentId == null
        && request.resource.data.claimCode == null
        && request.resource.data.claimedAt == null
        && request.resource.data.expiresAt == null
        && (request.resource.data.appointmentId == null || request.resource.data.appointmentId is string)
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 5
        && (request.resource.data.items.size() < 1 || purchaseItemValid(request.resource.data.barbershopId, request.resource.data.items[0]))
        && (request.resource.data.items.size() < 2 || purchaseItemValid(request.resource.data.barbershopId, request.resource.data.items[1]))
        && (request.resource.data.items.size() < 3 || purchaseItemValid(request.resource.data.barbershopId, request.resource.data.items[2]))
        && (request.resource.data.items.size() < 4 || purchaseItemValid(request.resource.data.barbershopId, request.resource.data.items[3]))
        && (request.resource.data.items.size() < 5 || purchaseItemValid(request.resource.data.barbershopId, request.resource.data.items[4]))
        && request.resource.data.totalAmount == purchaseItemsTotal(request.resource.data.items);

      allow update: if isSignedIn() && (
        // El comprador confirma su propio pago simulado ya aprobado y
        // recibe el código de reclamo (spec 10.3) — antes createPurchase
        // (Admin SDK) hacía esto en un solo paso; sin Cloud Functions se
        // separa en dos escrituras secuenciales (crear el pago -> esperar
        // -> aprobarlo -> ESTA transición), igual que el resto de flujos de
        // pago simulado de esta migración.
        (resource.data.buyerId == request.auth.uid &&
          resource.data.status == 'pending_payment' &&
          request.resource.data.status == 'pending_claim' &&
          request.resource.data.paymentId is string &&
          get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.payerId == request.auth.uid &&
          get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.category == 'product' &&
          get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.relatedId == id &&
          get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.status == 'approved' &&
          request.resource.data.claimCode is string &&
          request.resource.data.claimCode.matches('^[0-9A-Z]{8}$') &&
          request.resource.data.expiresAt is timestamp &&
          request.resource.data.expiresAt.toMillis() > request.time.toMillis() &&
          request.resource.data.expiresAt.toMillis() <= request.time.toMillis() + 25 * 60 * 60 * 1000 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentId', 'claimCode', 'status', 'expiresAt'])) ||
        // El comprador marca su propia compra 'payment_failed' si el pago
        // simulado no pudo aprobarse (rama defensiva: con
        // SimulatedNequiGateway esto no ocurre hoy, pero el contrato lo
        // prevé para un gateway real).
        (resource.data.buyerId == request.auth.uid &&
          resource.data.status == 'pending_payment' &&
          request.resource.data.status == 'payment_failed' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
        // El personal de ESA barbería (o el admin) marca la compra
        // reclamada (spec 10.4) — antes claimPurchase (Admin SDK).
        (resource.data.status == 'pending_claim' &&
          isStaffOfShop(resource.data.barbershopId) &&
          request.resource.data.status == 'claimed' &&
          request.resource.data.claimedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedAt'])) ||
        // Reembolso parcial por checklist de ítems (spec 6.5/10.5) —
        // reservado al admin, igual que en el backend. El monto ya lo
        // validó la actualización correspondiente de payments/{id}; aquí
        // solo se puede voltear 'refunded' de cada ítem, nunca su precio,
        // cantidad o nombre (ver purchaseItemRefundOnlyChanged arriba).
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items']) &&
          request.resource.data.items.size() == resource.data.items.size() &&
          (resource.data.items.size() < 1 || purchaseItemRefundOnlyChanged(resource.data.items[0], request.resource.data.items[0])) &&
          (resource.data.items.size() < 2 || purchaseItemRefundOnlyChanged(resource.data.items[1], request.resource.data.items[1])) &&
          (resource.data.items.size() < 3 || purchaseItemRefundOnlyChanged(resource.data.items[2], request.resource.data.items[2])) &&
          (resource.data.items.size() < 4 || purchaseItemRefundOnlyChanged(resource.data.items[3], request.resource.data.items[3])) &&
          (resource.data.items.size() < 5 || purchaseItemRefundOnlyChanged(resource.data.items[4], request.resource.data.items[4])))
      );

      allow delete: if false;
    }

    // ratings/{appointmentId}: antes la única vía de escritura era el
    // backend (submitAppointmentRating, Admin SDK); sin plan Blaze, el
    // propio cliente de la cita la crea directo (spec 7.1). El id del
    // documento ES el appointmentId, así un cliente no puede calificar la
    // misma cita dos veces (un segundo intento es un update() y no hay
    // regla que lo permita). effectiveShopStars/forcedRatingPenaltyApplied
    // quedan validados aquí exactamente igual que los calculaba el backend
    // — no se puede forzar el descuento de spec 3.4 ni evitarlo. El
    // incremento de ratingSum/ratingCount en barbershops/{id} y users/{id}
    // (el barbero) va en reglas aparte, ver los comentarios ahí.
    // Cualquier usuario autenticado puede leerlas, igual que el catálogo de
    // servicios/productos.
    match /ratings/{id} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && id == request.resource.data.appointmentId
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'appointmentId', 'barbershopId', 'barberId', 'clientId',
             'barberStars', 'shopStars', 'effectiveShopStars',
             'forcedRatingPenaltyApplied', 'createdAt'
           ])
        && request.resource.data.barberStars is int
        && request.resource.data.barberStars >= 1 && request.resource.data.barberStars <= 5
        && request.resource.data.shopStars is int
        && request.resource.data.shopStars >= 1 && request.resource.data.shopStars <= 5
        && get(/databases/$(database)/documents/appointments/$(id)).data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/appointments/$(id)).data.paid == true
        && get(/databases/$(database)/documents/appointments/$(id)).data.status == 'completed'
        && request.resource.data.barbershopId == get(/databases/$(database)/documents/appointments/$(id)).data.barbershopId
        && request.resource.data.barberId == get(/databases/$(database)/documents/appointments/$(id)).data.barberId
        && request.resource.data.forcedRatingPenaltyApplied ==
             (get(/databases/$(database)/documents/appointments/$(id)).data.forcedRatingPenalty == true)
        && request.resource.data.effectiveShopStars == (
             request.resource.data.forcedRatingPenaltyApplied
               ? (request.resource.data.shopStars > 1 ? request.resource.data.shopStars - 1 : 1)
               : request.resource.data.shopStars
           );

      allow update: if false;
      allow delete: if false;
    }

    // comments/{appointmentId}: antes la única vía de escritura era el
    // backend (submitAppointmentComment/replyToComment, Admin SDK); sin
    // plan Blaze, el propio cliente de la cita crea su comentario directo
    // (spec 7.2) y el personal de ESA barbería (o el admin) responde. La
    // moderación (spec 7.3) ahora corre en el cliente ANTES de decidir el
    // status a guardar — la regla valida que sea uno de los dos valores
    // válidos, pero no puede re-correr el filtro de moderación en sí
    // (límite aceptado, ver content_moderation_filter.dart). El id del
    // documento ES el appointmentId, así un cliente no puede comentar la
    // misma cita dos veces. Un comentario rechazado solo lo ve su propio
    // autor (para que sepa que no se publicó) o el personal/admin de esa
    // barbería; el resto de la app solo ve los publicados.
    match /comments/{id} {
      allow read: if isSignedIn() && (
        resource.data.status == 'published' ||
        resource.data.clientId == request.auth.uid ||
        isStaffOfShop(resource.data.barbershopId) ||
        isAdmin()
      );

      allow create: if isSignedIn()
        && id == request.resource.data.appointmentId
        && request.resource.data.keys().hasOnly([
             'appointmentId', 'barbershopId', 'barberId', 'clientId', 'clientName',
             'text', 'photoUrl', 'status', 'createdAt', 'replyText', 'replyAt',
             'repliedByBarberId'
           ])
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status in ['published', 'rejected']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && (request.resource.data.photoUrl == null || request.resource.data.photoUrl is string)
        && request.resource.data.replyText == null
        && request.resource.data.replyAt == null
        && request.resource.data.repliedByBarberId == null
        && get(/databases/$(database)/documents/appointments/$(id)).data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/appointments/$(id)).data.paid == true
        && get(/databases/$(database)/documents/appointments/$(id)).data.status == 'completed'
        && request.resource.data.barbershopId == get(/databases/$(database)/documents/appointments/$(id)).data.barbershopId
        && request.resource.data.barberId == get(/databases/$(database)/documents/appointments/$(id)).data.barberId;

      // El personal de la barbería responde (spec 7.2: "ya sea dirigido a
      // él o a la barbería en general" — por eso cualquier miembro del
      // personal de ESA barbería puede responder, no solo el barbero
      // atendido), solo a un comentario publicado y sin respuesta previa.
      allow update: if isSignedIn()
        && resource.data.status == 'published'
        && resource.data.replyText == null
        && isStaffOfShop(resource.data.barbershopId)
        && request.resource.data.replyText is string
        && request.resource.data.replyText.size() > 0 && request.resource.data.replyText.size() <= 500
        && request.resource.data.repliedByBarberId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyText', 'replyAt', 'repliedByBarberId']);

      allow delete: if false;
    }

    // notifications/{id}: antes la ÚNICA vía de escritura era el backend
    // (Cloud Function sendNotification -> notificationDispatcher, con
    // Admin SDK, entrega real por push/SMS/correo); sin plan Blaze, solo el
    // admin puede crear una directo — con la misma categoría acotada que
    // exigía el backend ('manual' o 'auto_payment_overdue', nunca las
    // categorías automáticas internas como recordatorios o cierres, que
    // nadie dispara desde la app). El destinatario (o el admin) puede
    // leerlas; el destinatario solo puede marcarlas como leídas, nunca
    // alterar su contenido.
    //
    // Limitación aceptada: sin servidor no hay entrega real por push/SMS/
    // correo — solo queda el registro en la lista dentro de la app.
    match /notifications/{id} {
      allow read: if isSignedIn() && (resource.data.toUserId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && isAdmin()
        && request.resource.data.toUserId is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUserId))
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 1000
        && request.resource.data.type in ['manual', 'auto_payment_overdue']
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() &&
        resource.data.toUserId == request.auth.uid &&
        request.resource.data.read == true &&
        request.resource.data.toUserId == resource.data.toUserId &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.body == resource.data.body &&
        request.resource.data.type == resource.data.type;
      allow delete: if false;
    }
  }
}
