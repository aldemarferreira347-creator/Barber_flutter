rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwnerOfShop(shopId) {
      return isSignedIn() && shopId != null &&
        exists(/databases/$(database)/documents/barbershops/$(shopId)) &&
        get(/databases/$(database)/documents/barbershops/$(shopId)).data.ownerId == request.auth.uid;
    }

    function isBarberOfShop(shopId) {
      return isSignedIn() && shopId != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'barber' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barbershopId == shopId;
    }

    function isStaffOfShop(shopId) {
      return isOwnerOfShop(shopId) || isBarberOfShop(shopId);
    }

    // users/{uid}: el autorregistro público solo puede crear rol 'client'
    // (Dueño se obtiene pagando, Barbero lo crea su Dueño, Admin no se
    // autorregistra — todo eso lo asigna el admin cambiando el rol después).
    // Un usuario puede editar su propio perfil pero NUNCA su propio rol ni
    // su propio estado 'active' (evita autopromoción y autodesbloqueo).
    match /users/{uid} {
      // Nota técnica: para que las CONSULTAS (no solo los get por id)
      // funcionen, Firestore exige poder demostrar la regla a partir del
      // propio filtro de la consulta — por eso estas condiciones dependen
      // solo de resource.data.role (que si va en el where de la consulta)
      // y no de funciones con get()/exists() como isOwnerOfShop().
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        // Perfiles de Cliente: los necesita el Dueño para buscarlos por
        // correo y contratarlos como Barbero.
        resource.data.role == 'client' ||
        // Perfiles de Barbero: los necesita el Cliente para elegir con
        // quién agendar su cita.
        resource.data.role == 'barber'
      );

      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'client'
        && request.resource.data.active == true;

      allow update: if isSignedIn()
        // awayUntilEstimate/awaySince (spec 3.3) solo los toca el backend
        // (markBarberAway/markBarberReturned/processOverdueBarbers, Admin
        // SDK) — el límite de tiempo sale del propio estimado del barbero,
        // y solo tiene sentido si nadie más puede alterarlo por su cuenta.
        && request.resource.data.awayUntilEstimate == resource.data.awayUntilEstimate
        && request.resource.data.awaySince == resource.data.awaySince
        // ratingSum/ratingCount (spec 7.1) del propio barbero: solo los
        // toca submitAppointmentRating (Admin SDK) — ni el barbero ni el
        // admin editando a mano pueden inflar su promedio.
        && request.resource.data.ratingSum == resource.data.ratingSum
        && request.resource.data.ratingCount == resource.data.ratingCount
        && (
          (request.auth.uid == uid &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.active == resource.data.active) ||
          isAdmin() ||
          // Auto-promoción Cliente -> Dueño al registrar su primera
          // barbería (spec 12.1). Antes pasaba por requestBarbershopOwnership
          // (Admin SDK), pero esa vía requiere el plan Blaze; esto la
          // reemplaza sin abrir hueco de seguridad porque el rol 'owner'
          // por sí solo no da NINGÚN permiso adicional — cada acción de
          // dueño (servicios, productos, horario, etc.) revalida por su
          // cuenta isOwnerOfShop(), que exige un barbershops/{id}.ownerId
          // == uid real, sin importar el rol declarado en users/{uid}.
          (request.auth.uid == uid &&
            resource.data.role == 'client' &&
            request.resource.data.role == 'owner' &&
            request.resource.data.active == resource.data.active) ||
          // Dueño contrata a un Cliente existente como Barbero de su negocio.
          (resource.data.role == 'client' &&
            request.resource.data.role == 'barber' &&
            isOwnerOfShop(request.resource.data.barbershopId) &&
            request.resource.data.active == resource.data.active) ||
          // Dueño da de baja a un Barbero de su propio negocio (vuelve a Cliente).
          (resource.data.role == 'barber' &&
            request.resource.data.role == 'client' &&
            request.resource.data.barbershopId == null &&
            isOwnerOfShop(resource.data.barbershopId) &&
            request.resource.data.active == resource.data.active)
        );

      allow delete: if false;
    }

    // barbershops/{id}: cualquier usuario autenticado puede leer (para que
    // el cliente navegue barberías; el catálogo visible se filtra en el
    // cliente por approvalStatus=='approved' && active==true). El dueño
    // crea/edita los datos básicos de la suya, pero NO puede cambiar
    // 'active', 'approvalStatus' ni 'paymentStatus' — esos campos son
    // aprobación/bloqueo exclusivo del admin (spec 12.1/12.4/12.6).
    //
    // Hallazgo de seguridad corregido aquí: antes el create() exigía
    // active==true && paymentStatus=='ok', es decir cualquier usuario
    // autenticado podía crear su propia barbería ya activa y visible en el
    // catálogo, sin revisión del admin. Ahora toda barbería nace
    // obligatoriamente 'pending' e inactiva.
    match /barbershops/{shopId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.active == false;

      allow update: if isSignedIn() && (
        (resource.data.ownerId == request.auth.uid &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.active == resource.data.active &&
          request.resource.data.approvalStatus == resource.data.approvalStatus &&
          request.resource.data.paymentStatus == resource.data.paymentStatus &&
          // ratingSum/ratingCount (spec 7.1) solo los toca
          // submitAppointmentRating (Admin SDK) — el dueño no puede
          // inflar su propio promedio editando el documento.
          request.resource.data.ratingSum == resource.data.ratingSum &&
          request.resource.data.ratingCount == resource.data.ratingCount) ||
        isAdmin() ||
        // El dueño paga/renueva la mensualidad de SU barbería (spec 12.5).
        // Antes pasaba por payBarbershopSubscription (Admin SDK) — sin
        // plan Blaze, la app simula el pago y escribe esto directo; la
        // regla exige la transición exacta ("queda al día y activa") y
        // que NINGÚN otro campo se toque en la misma escritura.
        (resource.data.ownerId == request.auth.uid &&
          resource.data.approvalStatus == 'approved' &&
          request.resource.data.active == true &&
          request.resource.data.paymentStatus == 'ok' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['active', 'paymentStatus', 'paymentDueDate'])) ||
        // El dueño cancela la membresía directamente: bloquea de inmediato,
        // sin período de gracia (spec 12.5) — antes cancelBarbershopSubscription.
        (resource.data.ownerId == request.auth.uid &&
          request.resource.data.active == false &&
          request.resource.data.paymentStatus == 'blocked' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['active', 'paymentStatus']))
      );

      allow delete: if isAdmin();

      // servicios de la barbería: el dueño de ESA barbería (o el admin) los
      // administra; cualquier usuario autenticado puede verlos (catálogo).
      match /services/{serviceId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isOwnerOfShop(shopId) || isAdmin());
      }

      // productos del catálogo: mismo criterio que servicios.
      match /products/{productId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isOwnerOfShop(shopId) || isAdmin());
      }

      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // appointments/{id}: el cliente crea su propia cita SIN pago (status
    // 'pending', paid false) directo. Las citas PAGADAS (spec 6.1/6.2)
    // antes solo las creaba bookPaidAppointment (Admin SDK, con bloqueo
    // transaccional del horario) — sin plan Blaze, la app corre la misma
    // transacción directo (ver appointmentSlots) y esta regla exige que el
    // precio no se falsifique y que haya un pago real (simulado) de ese
    // mismo cliente detrás.
    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.barberId == request.auth.uid ||
        isOwnerOfShop(resource.data.barbershopId) ||
        isAdmin()
      );

      allow create: if isSignedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pending'
        && (
          request.resource.data.paid == false ||
          (request.resource.data.paid == true &&
            request.resource.data.rescheduleHistory == [] &&
            request.resource.data.forcedRatingPenalty == false &&
            get(/databases/$(database)/documents/barbershops/$(request.resource.data.barbershopId)/services/$(request.resource.data.serviceId)).data.active == true &&
            request.resource.data.servicePrice ==
              get(/databases/$(database)/documents/barbershops/$(request.resource.data.barbershopId)/services/$(request.resource.data.serviceId)).data.price &&
            request.resource.data.paymentId is string &&
            get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.payerId == request.auth.uid)
        );

      allow update: if isSignedIn()
        && request.resource.data.paid == resource.data.paid
        && request.resource.data.paymentId == resource.data.paymentId
        // forcedRatingPenalty (spec 3.4) solo lo marca closeShopForExternalEvent
        // — ni el dueño ni el barbero de esa cita pueden quitárselo o
        // ponérselo por su cuenta editando el documento.
        && request.resource.data.forcedRatingPenalty == resource.data.forcedRatingPenalty
        && (
          resource.data.barberId == request.auth.uid ||
          isOwnerOfShop(resource.data.barbershopId) ||
          isAdmin() ||
          // El cliente solo puede cancelar directamente una cita SIN pago
          // (pending → cancelled); una cita pagada pasa por
          // requestAppointmentRefund (spec 6.3).
          (resource.data.clientId == request.auth.uid &&
            resource.data.paid == false &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'cancelled') ||
          // El cliente pospone su propia cita PAGADA (spec 6.4) — el
          // barbero y el dueño ya podían por la rama de arriba, sin
          // restricción de campos. Antes pasaba por postponeAppointment
          // (Admin SDK) con la misma transacción atómica que ahora corre
          // en el cliente (ver appointmentSlots).
          (resource.data.clientId == request.auth.uid &&
            resource.data.paid == true &&
            !(resource.data.status in ['cancelled', 'completed']) &&
            request.resource.data.status == 'postponed')
        );

      allow delete: if false;
    }

    // appointmentSlots/{id}: bloqueo de horario de una cita pagada (spec
    // 6.2/6.4). Antes lo creaba/borraba solo el backend (Admin SDK, dentro
    // de una transacción); sin plan Blaze, el cliente hace la misma
    // transacción (create() atómico: si el horario ya está tomado, falla
    // entero y no se crea ni la cita ni el pago). Nadie necesita leerlo.
    //
    // Alcance aceptado: cualquier usuario autenticado puede borrar
    // cualquier slot (no solo el propio) — el peor caso es liberar por
    // error o mala fe el horario de una cita ajena, no un problema de
    // datos ni de dinero real mientras el pago siga simulado; acotarlo más
    // exigiría cruzar con appointments solo para esto.
    match /appointmentSlots/{id} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['appointmentId', 'barberId', 'createdAt'])
        && request.resource.data.barberId is string
        && request.resource.data.appointmentId is string;
      allow update: if false;
      allow delete: if isSignedIn();
    }

    // shopClosures/{id}: registro de auditoría de cierres por evento
    // externo (spec 3.4) — solo lo crea closeShopForExternalEvent (Admin
    // SDK). El dueño de esa barbería (o el admin) puede consultarlo.
    match /shopClosures/{id} {
      allow read: if isSignedIn() && (isOwnerOfShop(resource.data.barbershopId) || isAdmin());
      allow write: if false;
    }

    // refundRequests/{id}: antes la única vía de escritura era el backend
    // (requestAppointmentRefund/resolveAppointmentRefund, Admin SDK); sin
    // plan Blaze, el cliente crea su propia solicitud (spec 6.3) y el
    // dueño de esa barbería (o el admin) la resuelve (spec 6.5), cada uno
    // acotado a exactamente esa transición. El cliente lee las suyas; el
    // dueño de esa barbería (o el admin) lee las de su barbería.
    match /refundRequests/{id} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        isOwnerOfShop(resource.data.barbershopId) ||
        isAdmin()
      );

      allow create: if isSignedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedBy == null
        && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.paid == true
        && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.status != 'cancelled';

      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && (isOwnerOfShop(resource.data.barbershopId) || isAdmin())
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy']);

      allow delete: if false;
    }

    // payments/{id}: la pasarela sigue simulada (no hay Nequi real ni
    // plan Blaze para correr requestPayment/refundPayment en el backend),
    // así que la propia app crea el registro "pendiente" y lo marca
    // "aprobado" tras un breve delay, igual que hacía SimulatedNequiGateway
    // del lado del servidor. El pagador nunca puede fabricar un pago ya
    // aprobado de una, ni tocar su monto una vez creado.
    match /payments/{id} {
      allow read: if isSignedIn() && (resource.data.payerId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.payerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.resolvedAt == null
        && request.resource.data.refundedAmount == null;

      allow update: if isSignedIn() && (
        // El pagador resuelve su propio pago simulado: aprobado tras el
        // delay, o rechazado si algo falló después de crearlo (p.ej. el
        // horario se lo ganó otro cliente) y hay que dejar constancia sin
        // dejarlo "pendiente" para siempre.
        (resource.data.payerId == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['approved', 'rejected'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])) ||
        // Reembolso al aprobar una solicitud de cancelación de cita (spec
        // 6.5): lo dispara el dueño de esa barbería (o el admin), no
        // necesariamente el propio pagador. Acotado a categoría
        // 'appointment' — otras categorías se migran aparte.
        (resource.data.category == 'appointment' &&
          resource.data.status == 'approved' &&
          request.resource.data.status == 'refunded' &&
          request.resource.data.refundedAmount is number &&
          request.resource.data.refundedAmount > 0 &&
          request.resource.data.refundedAmount <= resource.data.amount &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'refundedAmount', 'resolvedAt']) &&
          (isAdmin() || isOwnerOfShop(get(/databases/$(database)/documents/appointments/$(resource.data.relatedId)).data.barbershopId)))
      );

      allow delete: if false;
    }

    // purchases/{id}: la ÚNICA vía de escritura es el backend
    // (createPurchase/claimPurchase/refundPurchaseItems, con Admin SDK) —
    // el código de reclamo, el total y el estado nunca los decide el
    // cliente. El comprador lee las suyas; el personal de la barbería
    // (dueño o barbero de ESA barbería) lee las de su barbería para
    // atender reclamos; el admin lee todas.
    match /purchases/{id} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        isStaffOfShop(resource.data.barbershopId) ||
        isAdmin()
      );
      allow write: if false;
    }

    // ratings/{appointmentId}: la ÚNICA vía de escritura es el backend
    // (submitAppointmentRating, Admin SDK) — el id del documento ES el
    // appointmentId, así un cliente no puede calificar la misma cita dos
    // veces (el backend falla con already-exists en el segundo intento).
    // Cualquier usuario autenticado puede leerlas, igual que el catálogo
    // de servicios/productos.
    match /ratings/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // comments/{appointmentId}: la ÚNICA vía de escritura es el backend
    // (submitAppointmentComment/replyToComment, Admin SDK) — la moderación
    // (spec 7.3) corre ANTES de escribir el documento, nunca después, así
    // que un comentario rechazado nunca queda expuesto con status
    // 'published'. Un comentario rechazado solo lo ve su propio autor (para
    // que sepa que no se publicó) o el personal/admin de esa barbería; el
    // resto de la app solo ve los publicados.
    match /comments/{id} {
      allow read: if isSignedIn() && (
        resource.data.status == 'published' ||
        resource.data.clientId == request.auth.uid ||
        isStaffOfShop(resource.data.barbershopId) ||
        isAdmin()
      );
      allow write: if false;
    }

    // notifications/{id}: la ÚNICA vía de escritura es el backend (Cloud
    // Function sendNotification -> notificationDispatcher, con Admin SDK,
    // que no pasa por estas reglas) — así toda notificación, manual o
    // automática, comparte el mismo flujo de entrega (push/SMS/correo) sin
    // que el cliente pueda falsificar una a nombre del sistema. El
    // destinatario (o el admin) puede leerlas; el destinatario solo puede
    // marcarlas como leídas, nunca alterar su contenido.
    match /notifications/{id} {
      allow read: if isSignedIn() && (resource.data.toUserId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update: if isSignedIn() &&
        resource.data.toUserId == request.auth.uid &&
        request.resource.data.read == true &&
        request.resource.data.toUserId == resource.data.toUserId &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.body == resource.data.body &&
        request.resource.data.type == resource.data.type;
      allow delete: if false;
    }
  }
}
