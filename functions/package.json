{
  "name": "barber-functions",
  "description": "Backend de Cloud Functions para la app de gestión de barbería",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src test --ext .ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:rules": "firebase emulators:exec --project demo-barber --only firestore,storage \"jest --config jest.rules.config.js --runInBand\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,storage",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "babel-jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "firebase": "^11.9.1",
    "jest": "^29.7.0",
    "node-mocks-http": "^1.16.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
